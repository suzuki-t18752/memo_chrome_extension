{
  "manifest_version": 3,
  "name": "Sticky Memo",
  "version": "0.1.0",
  "description": "全ページで共通の簡単メモを残せる拡張機能",
  "permissions": ["storage"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Sticky Memo"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content_script.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
